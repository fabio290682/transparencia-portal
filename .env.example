DJANGO_DEBUG=false
DJANGO_SECRET_KEY=troque-por-uma-chave-forte
DJANGO_ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Alternativa ao DATABASE_URL (a aplicacao monta a URL automaticamente):
# DB_HOST=host
# DB_PORT=5432
# DB_NAME=banco
# DB_USER=usuario
# DB_PASSWORD=senha
# DB_SSLMODE=require
ALLOW_VERCEL_SQLITE_FALLBACK=true
DJANGO_SQLITE_PATH=/tmp/vercel.sqlite3
DJANGO_AUTO_MIGRATE_ON_BOOT=true
DJANGO_BOOTSTRAP_ADMIN_USERNAME=admin
DJANGO_BOOTSTRAP_ADMIN_PASSWORD=
DJANGO_BOOTSTRAP_ADMIN_EMAIL=

# Optional: used by docker-compose to build DATABASE_URL automatically
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=troque-por-senha-forte
ALLOW_PUBLIC_REGISTRATION=false
REGISTER_THROTTLE_RATE=5/hour
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
WAIT_FOR_DB=1
DB_MAX_ATTEMPTS=30
DB_RETRY_SECONDS=2

# Security (optional overrides)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
